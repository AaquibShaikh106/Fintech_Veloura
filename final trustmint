<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>TRUSTMINT – AI-Powered Debt Collections Platform</title>
<!--
=====================================================================
 TRUSTMINT | Team Veloura | Quasar 5.0 – FinTech Track
 FRONT-END ONLY (single file). Backend/API wiring is left for later.

 HOW THIS FILE IS ORGANISED (for the backend developer)
 1. <style>      : design tokens (CSS variables) + components
 2. <body>       : one <section class="page" id="..."> per screen
 3. <script>     : (a) MOCK DATA  (b) router  (c) renderers  (d) i18n
 
 API CONVENTIONS
 - Every spot that needs a backend call is tagged:  [API: METHOD /path] in HTML comments
   and/or in JS:  // API: METHOD /path
 - Replace the MOCK_* constants with fetch() results; the render functions
   don't need to change as long as the JSON shape stays the same.
 - Any button with  data-go="name"  navigates to #name. If no <section id="name">
   exists yet, a BLANK placeholder page is shown automatically.
   So: build the page later, give it id="name", and it just works.
 ===================================================================== -->
<style>
/* ---------- 1. DESIGN TOKENS: formal banking palette (navy / steel / white) ---------- */
:root{
  --navy:#0b2545; --navy-2:#13315c; --steel:#3e5c86; --accent:#1f7a8c;
  --bg:#f3f6fa; --card:#fff; --line:#dbe3ec; --text:#1b2a3a; --muted:#64768a;
  --ok:#2e7d4f; --warn:#c77d12; --bad:#b3261e; --radius:10px;
}
*{box-sizing:border-box} html{scroll-behavior:smooth}
body{margin:0;font:15px/1.55 "Segoe UI",Roboto,Arial,sans-serif;background:var(--bg);color:var(--text)}
h1,h2,h3{margin:0 0 .4em;color:var(--navy);line-height:1.25}
a{color:var(--accent)}
/* ---------- Header / nav ---------- */
header{background:var(--navy);color:#fff;position:sticky;top:0;z-index:20}
.bar{max-width:1200px;margin:auto;display:flex;align-items:center;gap:16px;padding:10px 20px;flex-wrap:wrap}
.brand{font-weight:700;font-size:20px;letter-spacing:.5px;cursor:pointer}
.brand small{display:block;font-weight:400;font-size:11px;opacity:.7;letter-spacing:0}
nav{display:flex;gap:4px;flex-wrap:wrap;flex:1}
nav a{color:#cfe0f5;text-decoration:none;padding:7px 12px;border-radius:6px;font-size:14px;cursor:pointer}
nav a:hover,nav a.on{background:var(--navy-2);color:#fff}
select,input,textarea{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:6px;background:#fff}
header select{background:var(--navy-2);color:#fff;border-color:var(--steel)}
/* ---------- Layout / components ---------- */
main{max-width:1200px;margin:auto;padding:24px 20px 60px}
.page{display:none} .page.on{display:block}
.grid{display:grid;gap:16px} .g2{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
.g3{grid-template-columns:repeat(auto-fit,minmax(230px,1fr))} .g4{grid-template-columns:repeat(auto-fit,minmax(190px,1fr))}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:18px}
.btn{display:inline-block;border:0;border-radius:6px;padding:9px 16px;font:inherit;font-weight:600;cursor:pointer;background:var(--navy);color:#fff}
.btn:hover{background:var(--navy-2)} .btn.alt{background:#fff;color:var(--navy);border:1px solid var(--navy)}
.btn.sm{padding:5px 10px;font-size:13px}
.kpi b{display:block;font-size:26px;color:var(--navy)} .kpi span{color:var(--muted);font-size:13px}
.tag{display:inline-block;padding:2px 9px;border-radius:99px;font-size:12px;font-weight:600}
.high{background:#fbe4e2;color:var(--bad)} .med{background:#fdf0d9;color:var(--warn)} .low{background:#e0f1e7;color:var(--ok)}
table{width:100%;border-collapse:collapse;font-size:14px} th,td{padding:10px 8px;border-bottom:1px solid var(--line);text-align:left}
th{color:var(--muted);font-weight:600;font-size:12px;text-transform:uppercase}
tr.row{cursor:pointer} tr.row:hover{background:#f0f5fb}
.tbl{overflow-x:auto}
.hero{background:linear-gradient(120deg,var(--navy),var(--steel));color:#fff;border-radius:14px;padding:44px 32px;margin-bottom:20px}
.hero h1{color:#fff;font-size:34px} .hero p{max-width:680px;opacity:.9}
.hero .btn{background:#fff;color:var(--navy)} .hero .btn.alt{background:transparent;color:#fff;border-color:#fff}
.bars{display:flex;align-items:flex-end;gap:10px;height:150px} .bars i{flex:1;background:var(--steel);border-radius:4px 4px 0 0;position:relative}
.bars i span{position:absolute;bottom:-20px;left:0;right:0;text-align:center;font-size:11px;color:var(--muted);font-style:normal}
.meter{height:8px;background:var(--line);border-radius:9px;overflow:hidden} .meter div{height:100%;background:var(--accent)}
.timeline{border-left:2px solid var(--line);margin:8px 0 0 6px;padding-left:14px} .timeline p{margin:0 0 10px;font-size:14px}
.timeline small{color:var(--muted)}
.blank{border:2px dashed var(--line);border-radius:var(--radius);padding:70px 20px;text-align:center;color:var(--muted)}
.chat{height:200px;overflow:auto;background:#f7f9fc;border:1px solid var(--line);border-radius:6px;padding:10px;margin-bottom:8px;font-size:14px}
.chat p{margin:0 0 8px} .chat .me{text-align:right;color:var(--navy)}
.note{font-size:12px;color:var(--muted)}
footer{text-align:center;color:var(--muted);font-size:12px;padding:20px}
/* ---------- AUTH: login portals (re-uses the existing colour tokens) ---------- */
[hidden]{display:none!important}
.auth{display:grid;grid-template-columns:1.25fr 1fr;gap:22px;align-items:stretch}
.auth-intro{grid-column:1/-1;text-align:center;margin-bottom:2px}.auth-intro p{color:var(--muted);margin:4px auto 0}
.acard{position:relative;border:1px solid var(--line);border-radius:14px;padding:30px 28px 24px;overflow:hidden;box-shadow:0 10px 30px rgba(11,37,69,.08);transition:box-shadow .25s,transform .25s}
.acard:hover{transform:translateY(-2px);box-shadow:0 16px 36px rgba(11,37,69,.14)}
.acard::before{content:"";position:absolute;left:0;right:0;top:0;height:5px;background:linear-gradient(90deg,var(--navy),var(--accent))}
.acard.cust{background:linear-gradient(160deg,#fff 55%,#e6f2f5)}.acard.mgr{background:linear-gradient(160deg,#fff 55%,#edf1f8)}
.acard.focus{box-shadow:0 0 0 3px rgba(31,122,140,.35),0 16px 36px rgba(11,37,69,.14)}
.abadge{position:absolute;top:18px;right:18px;font-size:11px;font-weight:600;color:var(--accent);background:#e3f1f3;padding:3px 10px;border-radius:99px}
.aicon{width:54px;height:54px;border-radius:14px;background:linear-gradient(135deg,var(--navy),var(--steel));color:#fff;display:grid;place-items:center;font-size:26px;margin-bottom:14px}
.acard h2{margin-bottom:2px}.field{display:block;margin:16px 0 5px;font-weight:600;font-size:13px;color:var(--navy)}
.acard input{width:100%}.acard input:focus{outline:2px solid var(--accent);border-color:var(--accent)}.acard input.bad{border-color:var(--bad)}
.mob{display:flex}.mob span{display:grid;place-items:center;padding:0 12px;background:var(--bg);border:1px solid var(--line);border-right:0;border-radius:6px 0 0 6px;font-weight:600;color:var(--navy)}.mob input{border-radius:0 6px 6px 0}
.pw{position:relative}.pw button{position:absolute;right:6px;top:5px;border:0;background:none;color:var(--accent);font-weight:600;cursor:pointer;padding:5px 8px}
.otp{display:flex;gap:8px;margin:12px 0 4px}.acard .otp input{width:100%;height:54px;text-align:center;font-size:22px;font-weight:700;padding:0;color:var(--navy)}
.err{color:var(--bad);font-size:13px;min-height:20px;margin-top:6px}
.acard .btn{width:100%;padding:12px;margin-top:6px;font-size:15px}.acard a{cursor:pointer;font-weight:600}.acard a.off{color:var(--muted);pointer-events:none}
.trust{grid-column:1/-1;display:flex;gap:26px;flex-wrap:wrap;justify-content:center;color:var(--muted);font-size:13px}
header .btn.alt{background:transparent}  /* header buttons: white text on navy (was white-on-white) */
.who{color:#cfe0f5;font-size:13px}.who b{color:#fff}
.gate{max-width:1200px;margin:0 auto 14px;background:#fdf0d9;color:var(--warn);border:1px solid #f0d9ad;border-radius:8px;padding:10px 14px;font-weight:600}
@media(max-width:820px){.auth{grid-template-columns:1fr}}
</style>
</head>
<body>

<!-- ================= HEADER + NAVIGATION ================= -->
<header><div class="bar">
  <div class="brand" data-go="home">TRUSTMINT<small data-i18n="tagline">Building Trust. Simplifying Recovery.</small></div>
  <!-- data-roles = who may SEE the link. Real protection must be enforced by the backend. -->
  <nav id="nav">
    <a data-go="home" data-roles="public customer manager" data-i18n="nav_home">Home</a>
    <a data-go="manager" data-roles="manager" data-i18n="nav_manager">Manager Dashboard</a>
    <a data-go="cases" data-roles="manager" data-i18n="nav_cases">Case Prioritisation</a>
    <a data-go="agents" data-roles="manager" data-i18n="nav_agents">Field Agents</a>
    <a data-go="reminders" data-roles="manager" data-i18n="nav_rem">Reminders</a>
    <a data-go="compliance" data-roles="manager" data-i18n="nav_comp">Compliance</a>
    <a data-go="borrower" data-roles="customer" data-i18n="nav_borrower">Borrower Portal</a>
    <a data-go="my-reminders" data-roles="customer">My Reminders</a>
  </nav>
  <!-- Multilingual support: English / Hindi / Marathi (see I18N in script) -->
  <select id="lang" aria-label="Language"><option value="en">English</option><option value="hi">हिन्दी</option><option value="mr">मराठी</option></select>
  <!-- Shown after login: who is signed in + Logout. API: POST /api/auth/logout -->
  <span class="who" id="who" hidden><b id="whoRole"></b> · <span id="whoId"></span></span>
  <button class="btn alt sm" id="loginBtn" style="color:#fff;border-color:#fff" data-go="login" data-i18n="login">Login</button>
  <button class="btn alt sm" id="logoutBtn" style="color:#fff;border-color:#fff" hidden>Logout</button>
</div></header>

<main>

<!-- ================= HOME / LANDING ================= -->
<section class="page" id="home">
  <div class="hero">
    <h1>AI-Powered Debt Collections Platform</h1>
    <p>One connected system for banks, NBFCs, managers, field agents and borrowers. Intelligent risk scoring, automated case prioritisation, and coordinated digital and field collection – faster, smarter and fairer recovery.</p>
    <button class="btn" data-go="login">Customer Login</button>
    <button class="btn alt" data-go="manager-login">Bank Manager Login</button>
  </div>

  <!-- The 9 proposed features. Each card links to its screen (or a blank page if not built). -->
  <h2>Platform capabilities</h2>
  <div class="grid g3" id="features"></div>

  <h2 style="margin-top:28px">Built for both sides</h2>
  <div class="grid g2">
    <div class="card"><h3>🏦 For banks &amp; NBFCs</h3><p>Replace spreadsheets with one live record per account. Prioritise by risk, avoid wasted field visits, track agents, and keep audit-ready compliance logs.</p></div>
    <div class="card"><h3>👤 For borrowers</h3><p>See dues and payment history in one place, get respectful reminders in your language, and find repayment support. No repeated or duplicate contact.</p></div>
  </div>
</section>

<!-- ================= MANAGER DASHBOARD ================= -->
<section class="page" id="manager">
  <h2>Manager Dashboard</h2>
  <!-- API: GET /api/dashboard/summary  → fills #kpis, #trend, #mix -->
  <div class="grid g4" id="kpis"></div>
  <div class="grid g2" style="margin-top:16px">
    <div class="card"><h3>Recovery trend (₹ lakh, last 6 months)</h3><div class="bars" id="trend"></div><br></div>
    <div class="card"><h3>Overdue accounts by risk</h3><div id="mix"></div>
      <!-- Swap CSS bars for Chart.js here if desired (cdnjs, pinned version) -->
    </div>
  </div>
  <div class="card" style="margin-top:16px"><h3>Agent performance</h3><div class="tbl"><table id="perf"></table></div>
    <button class="btn alt sm" data-go="reports">Export report</button> <!-- API: GET /api/reports/export -->
  </div>
</section>

<!-- ================= CASE PRIORITISATION + RISK EXPLANATION ================= -->
<section class="page" id="cases">
  <h2>Smart Case Prioritisation</h2>
  <p class="note">AI recommends; humans decide. Click a case to see why it received its score and the unified account record.</p>
  <div class="grid g2" style="grid-template-columns:1.4fr 1fr">
    <div class="card"><div class="tbl"><table id="caseTable"></table></div></div>
    <div class="card" id="caseDetail"><p class="note">Select a case.</p></div>
  </div>
</section>

<!-- ================= FIELD AGENTS ================= -->
<section class="page" id="agents">
  <h2>Field Agent Management</h2>
  <div class="grid g2">
    <div class="card"><h3>Agents</h3><div class="tbl"><table id="agentTable"></table></div>
      <button class="btn sm" data-go="assign">Assign cases</button> <!-- API: POST /api/assignments -->
    </div>
    <div class="card"><h3>Live agent map</h3>
      <!-- API: GET /api/agents/locations → plug in map SDK here (Google Maps / Leaflet) -->
      <div class="blank" style="padding:60px 10px">Map placeholder<br><small>Needs maps API key</small></div>
    </div>
  </div>
</section>

<!-- ================= AUTOMATED REMINDERS ================= -->
<section class="page" id="reminders">
  <h2>Automated Digital Reminders</h2>
  <div class="grid g2">
    <div class="card"><h3>Message preview</h3>
      <label>Channel <select id="remCh"><option>SMS</option><option>WhatsApp</option><option>Email</option></select></label>
      <label>Tone <select id="remTone"><option>Polite</option><option>Supportive</option></select></label>
      <div class="chat" id="remPreview" style="height:auto;min-height:90px;margin-top:10px"></div>
      <!-- API: POST /api/reminders/generate (AI text)  |  POST /api/reminders/send -->
      <button class="btn" data-go="send-reminder">Send reminder</button>
      <p class="note">Sending is checked against contact limits and consent before dispatch.</p>
    </div>
    <div class="card"><h3>Contact-limit guard</h3>
      <p>Contacts this week for selected borrower: <b>2 / 3</b></p><div class="meter"><div style="width:66%"></div></div>
      <p class="note">A duplicate follow-up (same borrower, same day, different team) is flagged and blocked automatically.</p>
      <p><span class="tag med">Duplicate flagged</span> Case C-1042 – call already logged today by Agent Rohan.</p>
    </div>
  </div>
</section>

<!-- ================= BORROWER PORTAL ================= -->
<section class="page" id="borrower">
  <h2>Borrower Portal</h2>
  <!-- API: GET /api/borrower/me → loan, dues, history -->
  <div class="grid g3">
    <div class="card kpi"><span>Outstanding amount</span><b>₹ 18,450</b></div>
    <div class="card kpi"><span>Next EMI due</span><b>12 Nov 2026</b></div>
    <div class="card kpi"><span>Status</span><b><span class="tag med">1 EMI overdue</span></b></div>
  </div>
  <div class="grid g2" style="margin-top:16px">
    <div class="card"><h3>Dues breakdown</h3>
      <table><tr><td>Principal overdue</td><td>₹ 16,200</td></tr><tr><td>Late charges</td><td>₹ 450</td></tr><tr><td>Upcoming EMI</td><td>₹ 1,800</td></tr></table><br>
      <!-- API: POST /api/payments/initiate (payment gateway) -->
      <button class="btn" data-go="pay">Pay now</button>
      <button class="btn alt" data-go="repay-plan">Request repayment support</button>
    </div>
    <div class="card"><h3>AI Borrower Assistant</h3>
      <div class="chat" id="chat"><p>Hello! Ask me about your dues, EMI schedule or repayment options.</p></div>
      <!-- API: POST /api/assistant/chat  → replace placeholder reply in sendChat() -->
      <div style="display:flex;gap:6px"><input id="chatIn" style="flex:1" placeholder="Type your question…"><button class="btn" id="chatBtn">Send</button></div>
    </div>
  </div>
  <div class="card" style="margin-top:16px"><h3>Payment &amp; follow-up history</h3>
    <div class="timeline">
      <p>Payment of ₹1,800 received <br><small>05 Oct 2026 · updates all dashboards instantly</small></p>
      <p>Reminder sent via SMS (Hindi) <br><small>28 Oct 2026</small></p>
      <p>EMI due date missed <br><small>01 Nov 2026</small></p>
    </div>
  </div>
</section>

<!-- ================= COMPLIANCE & TRANSPARENCY ================= -->
<section class="page" id="compliance">
  <h2>Compliance &amp; Transparency</h2>
  <div class="grid g3">
    <div class="card kpi"><span>Max contacts / borrower / week</span><b>3</b></div>
    <div class="card kpi"><span>Consent on record</span><b>96%</b></div>
    <div class="card kpi"><span>Contact hours allowed</span><b>8 AM – 7 PM</b></div>
  </div>
  <div class="card" style="margin-top:16px"><h3>Activity audit log</h3>
    <!-- API: GET /api/audit-logs?limit=50 -->
    <div class="tbl"><table id="audit"></table></div>
    <button class="btn alt sm" data-go="reports">Download audit report</button>
  </div>
</section>

<!-- Access-notice banner (filled by showGate()) -->
<div class="gate" id="gate" hidden></div>

<!-- ================= LOGIN PORTALS (public) =================
     #login          → both portals (Customer first: most users are borrowers)
     #manager-login  → same page, Manager card highlighted
     Front-end validation only. API calls are marked in the script (section 3e). -->
<section class="page" id="login">
 <div class="auth">
  <div class="auth-intro"><h1 style="font-size:30px">Welcome to TRUSTMINT</h1><p>Choose your portal and sign in.</p></div>

  <!-- CUSTOMER PORTAL: mobile number + OTP -->
  <div class="acard cust" id="custCard">
   <span class="abadge">For borrowers</span>
   <div class="aicon">👤</div><h2>Customer Login</h2>
   <p class="note" style="font-size:13px">Sign in with your registered mobile number. We will send you a one-time password.</p>
   <div id="custStep1">
     <label class="field" for="mob">Mobile number</label>
     <div class="mob"><span>+91</span><input id="mob" type="tel" inputmode="numeric" maxlength="10" autocomplete="tel-national" placeholder="10-digit mobile number"></div>
     <div class="err" id="mobErr" role="alert"></div>
     <button class="btn" id="otpSend">Send OTP</button>
   </div>
   <div id="custStep2" hidden>
     <label class="field">Enter the 6-digit OTP sent to</label><b id="mobShow"></b>
     <div class="otp" id="otpBoxes"></div>
     <div class="err" id="otpErr" role="alert"></div>
     <button class="btn" id="otpVerify">Verify &amp; Login</button>
     <p class="note" style="margin-top:12px"><a id="otpResend" class="off">Resend OTP</a><span id="otpTimer"></span> &nbsp;·&nbsp; <a id="otpChange">Change number</a></p>
   </div>
   <p class="note" style="margin-top:14px">Demo mode: any 10-digit number and any 6-digit OTP works until the backend is connected.</p>
  </div>

  <!-- BANK MANAGER PORTAL: work email + password -->
  <div class="acard mgr" id="mgrCard">
   <span class="abadge">For bank staff</span>
   <div class="aicon">🏦</div><h2>Bank Manager Login</h2>
   <p class="note" style="font-size:13px">For bank and NBFC staff. Sign in with your work email and password.</p>
   <label class="field" for="memail">Work email</label>
   <input id="memail" type="email" autocomplete="username" placeholder="name@bank.com">
   <div class="err" id="emailErr" role="alert"></div>
   <label class="field" for="mpass" style="margin-top:0">Password</label>
   <div class="pw"><input id="mpass" type="password" autocomplete="current-password" placeholder="Password"><button type="button" id="pwToggle">Show</button></div>
   <div class="err" id="passErr" role="alert"></div>
   <button class="btn" id="mgrLogin">Login</button>
   <p class="note" style="margin-top:14px">Demo mode: any valid email and any password works until the backend is connected.</p>
  </div>

  <div class="trust"><span>🔒 OTP-based customer sign-in</span><span>🛡️ Role-based access</span><span>📋 Activity is logged for compliance</span></div>
 </div>
</section>

<!-- ================= CUSTOMER: MY REMINDERS (customer only) =================
     API: GET /api/borrower/me/reminders  → replace the sample items below -->
<section class="page" id="my-reminders">
  <h2>My Reminders</h2>
  <p class="note">Every message sent to you about your loan, in one place.</p>
  <div class="grid g3" style="margin:12px 0">
    <div class="card kpi"><span>Max contacts / borrower / week</span><b>3</b></div>
    <div class="card kpi"><span>Contact hours allowed</span><b>8 AM – 7 PM</b></div>
  </div>
  <div class="card"><div class="timeline">
    <p>EMI due reminder via WhatsApp (English) <br><small>05 Nov 2026</small></p>
    <p>Reminder sent via SMS (Hindi) <br><small>28 Oct 2026</small></p>
  </div></div>
</section>

<!-- ================= BLANK PLACEHOLDER (auto-used for any unbuilt page) ================= -->
<section class="page" id="blank">
  <div class="blank"><h2 id="blankTitle">Page</h2><p>This page is intentionally blank – to be built together with its API.</p>
    <button class="btn alt" data-go="home">← Back to Home</button></div>
</section>

</main>
<footer>TRUSTMINT · Team Veloura · Quasar 5.0 FinTech · Prototype with sample data only</footer>

<script>
/* =====================================================================
   3a. MOCK DATA – replace each with fetch() results from the backend.
   ===================================================================== */
// API: GET /api/dashboard/summary
const MOCK_KPI=[["Overdue accounts","4,812"],["Recovered this month","₹ 1.9 Cr"],["Pending payments","₹ 6.4 Cr"],["Digital-resolved","58%"]];
const MOCK_TREND=[["Jun",38],["Jul",52],["Aug",47],["Sep",66],["Oct",78],["Nov",90]];
const MOCK_MIX=[["High",22,"high"],["Medium",41,"med"],["Low",37,"low"]];
// API: GET /api/cases?sort=priority
const MOCK_CASES=[
 {id:"C-1042",name:"R. Sharma",due:42500,dpd:47,score:86,level:"high",lang:"Hindi",action:"Field visit (digital reminders ignored)",
  why:["3 missed EMIs in last 6 months (+32)","No response to last 4 reminders (+24)","Outstanding > 40% of loan (+18)","Salary-date pattern on 1st (-6 ⇒ visit after 3rd)"]},
 {id:"C-1077",name:"P. Deshmukh",due:18450,dpd:12,score:58,level:"med",lang:"Marathi",action:"Digital reminder + offer EMI restructure",
  why:["1 missed EMI, earlier history clean (+20)","Opened last reminder but didn't pay (+16)","Partial payment made in September (-8)"]},
 {id:"C-1103",name:"A. Khan",due:6200,dpd:5,score:24,level:"low",lang:"English",action:"Automated SMS reminder only",
  why:["Always paid within 7 days historically (-30)","Payment app autopay failed once (+10)"]}];
