              mr:{Jan:"जाने.",Feb:"फेब्रु.",Mar:"मार्च",Apr:"एप्रि.",May:"मे",Jun:"जून",Jul:"जुलै",Aug:"ऑग.",Sep:"सप्टें.",Oct:"ऑक्टो.",Nov:"नोव्हें.",Dec:"डिसें."}};
const TXT=new WeakMap(), ATT=new WeakMap();   // remember original English of each text node / placeholder
function tx(base,l){                           // translate one string (keeps surrounding spaces)
  if(l==="en")return base;
  const m=base.match(/^(\s*)([\s\S]*?)(\s*)$/), core=m[2]; if(!core)return base;
  let hit=D[core]&&D[core][l];
  if(!hit){const p=core.match(/^([^\p{L}\p{N}\[]*)([\s\S]*)$/u);          // ignore leading emoji / arrows / bullets
           if(p[1]&&D[p[2]]&&D[p[2]][l])hit=p[1]+D[p[2]][l];}
  if(!hit&&/^\d{2} [A-Z][a-z]{2}\b/.test(core))hit=core.replace(/ ([A-Z][a-z]{2})\b/,(x,mo)=>" "+(MONTHS[l][mo]||mo)); // "04 Nov 10:42"
  return hit?m[1]+hit+m[3]:base}
function applyLang(){
  const w=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);
  for(let n;n=w.nextNode();){
    const el=n.parentElement; if(!el||/^(SCRIPT|STYLE)$/.test(el.tagName)||el.closest("#lang,#remPreview"))continue;
    if(!TXT.has(n))TXT.set(n,n.nodeValue);
    const v=tx(TXT.get(n),LANG); if(n.nodeValue!==v)n.nodeValue=v}
  document.querySelectorAll("[placeholder]").forEach(e=>{if(!ATT.has(e))ATT.set(e,e.placeholder);e.placeholder=tx(ATT.get(e),LANG)});
  document.title=tx("TRUSTMINT – AI-Powered Debt Collections Platform",LANG);
  document.documentElement.lang=LANG}
const OBS_CFG={childList:true,subtree:true};
const obs=new MutationObserver(()=>{if(LANG==="en")return;obs.disconnect();applyLang();obs.observe(document.body,OBS_CFG)}); // new content ⇒ translate it
$("lang").onchange=e=>{LANG=e.target.value;obs.disconnect();applyLang();$("remPreview").textContent=remText();obs.observe(document.body,OBS_CFG)};

/* =====================================================================
   3e. AUTH – front-end session, role guard, login forms.
   ⚠ NOT real security: everything here can be bypassed from the browser.
   The backend must verify the token on EVERY API request and enforce roles.

   API CONTRACT (to build later)
   - POST /api/auth/customer/request-otp  {mobile}            → 200 (OTP sent by SMS)
   - POST /api/auth/customer/verify-otp   {mobile, otp}       → {token, role:"customer", customer}
   - POST /api/auth/manager/login         {email, password}   → {token, role:"manager", user}
   - POST /api/auth/logout                                    → 204
   - GET  /api/auth/me                                        → {role, id}   (restore session on reload)
   Store the token in an httpOnly cookie (preferred) instead of the demo session below.
   ===================================================================== */
const SESS_KEY="tm_session";
const ROLE_PAGES={customer:["home","borrower","my-reminders"],manager:["home","manager","cases","agents","reminders","compliance"]}; // pages each role may open
const ROLE_HOME={customer:"borrower",manager:"manager"};                                                                          // landing page after login
let memSess=null; try{memSess=JSON.parse(sessionStorage.getItem(SESS_KEY))}catch(e){}
function getSession(){return memSess}
function setSession(v){memSess=v;try{v?sessionStorage.setItem(SESS_KEY,JSON.stringify(v)):sessionStorage.removeItem(SESS_KEY)}catch(e){}}
let gateTimer;function showGate(msg){const g=$("gate");g.textContent=msg;g.hidden=false;clearTimeout(gateTimer);gateTimer=setTimeout(()=>g.hidden=true,4500)}
function applyAuthUI(){                       // show/hide nav links, user chip and Login/Logout buttons
  const s=getSession(), r=s?s.role:"public";
  document.querySelectorAll("#nav a").forEach(a=>a.hidden=!(a.dataset.roles||"public").split(" ").includes(r));
  $("loginBtn").hidden=!!s;$("logoutBtn").hidden=!s;$("who").hidden=!s;
  if(s){$("whoRole").textContent=s.role==="manager"?"Bank Manager":"Customer";$("whoId").textContent=s.id}
}
function signIn(role,id){setSession({role,id});location.hash=ROLE_HOME[role];route()}
$("logoutBtn").onclick=()=>{ /* API: POST /api/auth/logout */
  setSession(null);resetLogin();if(location.hash==="#home"){route()}else{location.hash="home"}};

/* ---- helpers ---- */
const setErr=(id,msg,inp)=>{$(id).textContent=msg;if(inp)inp.classList.toggle("bad",!!msg)};
function resetLogin(){["mob","memail","mpass"].forEach(i=>{$(i).value="";$(i).classList.remove("bad")});
  ["mobErr","otpErr","emailErr","passErr"].forEach(i=>setErr(i,""));boxes.forEach(b=>b.value="");
  $("custStep1").hidden=false;$("custStep2").hidden=true;clearInterval(otpInt)}

/* ---- CUSTOMER: mobile → OTP ---- */
const boxes=[];let pendingMobile="",otpInt;
for(let i=0;i<6;i++){const b=document.createElement("input");b.maxLength=1;b.inputMode="numeric";b.autocomplete="one-time-code";b.setAttribute("aria-label","OTP digit "+(i+1));$("otpBoxes").appendChild(b);boxes.push(b)}
boxes.forEach((b,i)=>{
  b.oninput=()=>{b.value=b.value.replace(/\D/g,"");if(b.value&&i<5)boxes[i+1].focus()};
  b.onkeydown=e=>{if(e.key==="Backspace"&&!b.value&&i>0)boxes[i-1].focus();if(e.key==="Enter")$("otpVerify").click()};
  b.onpaste=e=>{const t=(e.clipboardData.getData("text")||"").replace(/\D/g,"").slice(0,6);if(t){e.preventDefault();[...t].forEach((c,k)=>boxes[k].value=c);boxes[Math.min(t.length,5)].focus()}}});
$("mob").oninput=e=>{e.target.value=e.target.value.replace(/\D/g,"")};
$("mob").onkeydown=e=>{if(e.key==="Enter")$("otpSend").click()};
function startTimer(){let n=30;clearInterval(otpInt);$("otpResend").classList.add("off");
  const tick=()=>{$("otpTimer").textContent=n>0?" ("+n+"s)":"";if(n--<=0){clearInterval(otpInt);$("otpResend").classList.remove("off")}};tick();otpInt=setInterval(tick,1000)}
function sendOtp(){const m=$("mob").value.trim();
  if(!/^\d{10}$/.test(m)){setErr("mobErr","Enter a valid 10-digit mobile number.",$("mob"));return}
  setErr("mobErr","",$("mob"));
  // API: POST /api/auth/customer/request-otp  {mobile:m}
  pendingMobile=m;$("mobShow").textContent="+91 "+m.slice(0,2)+"••••••"+m.slice(-2);
  $("custStep1").hidden=true;$("custStep2").hidden=false;boxes.forEach(b=>b.value="");boxes[0].focus();startTimer()}
$("otpSend").onclick=sendOtp;
$("otpResend").onclick=()=>{if(!$("otpResend").classList.contains("off")){sendOtp()}};   // API: same request-otp call
$("otpChange").onclick=()=>{clearInterval(otpInt);$("custStep2").hidden=true;$("custStep1").hidden=false;$("mob").focus()};
$("otpVerify").onclick=()=>{const code=boxes.map(b=>b.value).join("");
  if(!/^\d{6}$/.test(code)){setErr("otpErr","Enter the 6-digit OTP.");return}
  setErr("otpErr","");
  // API: POST /api/auth/customer/verify-otp  {mobile:pendingMobile, otp:code} → on success store token
  clearInterval(otpInt);signIn("customer","+91 "+pendingMobile.slice(0,2)+"••••••"+pendingMobile.slice(-2))};

/* ---- MANAGER: email + password ---- */
$("pwToggle").onclick=()=>{const p=$("mpass"),show=p.type==="password";p.type=show?"text":"password";$("pwToggle").textContent=show?"Hide":"Show"};
$("mgrLogin").onclick=()=>{const em=$("memail").value.trim(),pw=$("mpass").value;let ok=true;
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(em)){setErr("emailErr","Enter a valid email address.",$("memail"));ok=false}else setErr("emailErr","",$("memail"));
  if(!pw){setErr("passErr","Enter your password.",$("mpass"));ok=false}else setErr("passErr","",$("mpass"));
  if(!ok)return;
  // API: POST /api/auth/manager/login  {email:em, password:pw} → on success store token
  signIn("manager",em)};
["memail","mpass"].forEach(i=>$(i).onkeydown=e=>{if(e.key==="Enter")$("mgrLogin").click()});

route(); // initial render
obs.observe(document.body,OBS_CFG); // keep translating content added later
</script>
</body>
</html>
