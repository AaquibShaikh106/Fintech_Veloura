/* =====================================================================
   3b. ROUTER – hash based (#manager, #cases …). Unknown ⇒ blank page.
   ===================================================================== */
function route(){
  let name=(location.hash||"#home").slice(1)||"home";
  const sess=getSession(), role=sess&&sess.role;
  const focusCard=name==="manager-login"?"mgrCard":name==="customer-login"?"custCard":null;
  if(focusCard)name="login";                              // aliases of the login page
  const page=document.getElementById(name), known=!!(page&&page.classList.contains("page"));
  /* ---- ROLE GUARD (front-end only; the backend must enforce the same rules) ---- */
  if(role){
    if(name==="login"){location.hash=ROLE_HOME[role];return}                       // already signed in
    if(known&&!ROLE_PAGES[role].includes(name)){showGate("This page isn't available for your account.");location.hash=ROLE_HOME[role];return}
  }else if(name!=="home"&&name!=="login"){showGate("Please sign in to open that page.");location.hash="login";return}
  applyAuthUI();
  document.querySelectorAll(".page").forEach(p=>p.classList.remove("on"));
  if(known){page.classList.add("on")}
  else{document.getElementById("blankTitle").textContent=name.replace(/-/g," ").replace(/^./,c=>c.toUpperCase());document.getElementById("blank").classList.add("on")}
  document.querySelectorAll("nav a").forEach(a=>a.classList.toggle("on",a.dataset.go===name));
  ["custCard","mgrCard"].forEach(id=>$(id).classList.toggle("focus",id===focusCard));
  if(focusCard)setTimeout(()=>$(focusCard==="mgrCard"?"memail":"mob").focus(),50);
  scrollTo(0,0);
}
document.addEventListener("click",e=>{const t=e.target.closest("[data-go]");if(t){location.hash=t.dataset.go}});
addEventListener("hashchange",route);

